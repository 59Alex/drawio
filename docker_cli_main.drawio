        <mxCell id="kOdEl1zKcEWFtkfrxy2P-15" value="For clear resources" style="rounded=0;whiteSpace=wrap;html=1;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;fontFamily=Courier New;fontSize=15;" vertex="1" parent="kOdEl1zKcEWFtkfrxy2P-23">
