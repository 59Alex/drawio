        </mxCell>
        <mxCell id="kOdEl1zKcEWFtkfrxy2P-7" value="&lt;div&gt;docker run -it --name my-container ubuntu bash - создание и запуск контейнера с &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;выполнением действия (пример с ubuntu, открывает терминал bash)&lt;/div&gt;&lt;div&gt;docker run -d -p 8080:80 --name web nginx - создание и запуск контейнера в &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;фоновом режиме с пробросом портов (пример с njinx)&lt;br&gt;&lt;/div&gt;&lt;div&gt;docker run -v $(pwd)/data:/app/data myapp - монтирование тома (монтирует ./data &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;папку в том /app/data контейнера)&lt;/div&gt;&lt;div&gt;docker restart web - перезапуск&lt;/div&gt;&lt;div&gt;docker stop web - остановка&lt;/div&gt;&lt;div&gt;docker rm web - удаление (docker rm -f web - удалить принудительно)&lt;/div&gt;&lt;div&gt;docker ps - отобразить список запущенных контейнеров (docker ps -a - включая &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;остановленные)&lt;/div&gt;&lt;div&gt;docker logs -f web - просмотр логов&lt;/div&gt;&lt;div&gt;docker exec -it web bash - выполнение команды внутри контейнера (открывает bash)&lt;/div&gt;&lt;div&gt;docker inspect web - отображение информации о контейнере (см. слева)&lt;/div&gt;&lt;div&gt;docker pull postgres:16 - загрузка образа&lt;/div&gt;&lt;div&gt;docker save myapp &amp;gt; myapp.tar - сохранение образа в архив&lt;/div&gt;&lt;div&gt;docker load &amp;lt; myapp.tar - распаковка образа&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=8;" vertex="1" parent="kOdEl1zKcEWFtkfrxy2P-19">
          <mxGeometry x="391" y="302" width="400" height="177" as="geometry" />
        </mxCell>
        <mxCell id="kOdEl1zKcEWFtkfrxy2P-17" value="&lt;div&gt;Пример работы с .jar с помощью docker&lt;br&gt;&lt;/div&gt;&lt;div&gt;Dockerfile:&lt;br&gt;&lt;/div&gt;&lt;div&gt;FROM eclipse-temurin:17-jdk-jammy&lt;/div&gt;WORKDIR /app # Рабочая директория внутри контейнера&lt;br&gt;COPY my-app.jar /app/my-app.jar # Копируем JAR-файл&lt;br&gt;VOLUME /app/logs # Том для логов&lt;br&gt;EXPOSE 8080 # Пробрасываем порт&lt;br&gt;&lt;div&gt;CMD [&quot;java&quot;, &quot;-jar&quot;, &quot;/app/my-app.jar&quot;] # Запускаем JAR&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;docker build -t my-jar-app .&lt;br&gt;docker volume create app-logs&lt;/div&gt;&lt;div&gt;docker run -d --name my-app -p 8080:8080 -v app-logs:/app/logs my-jar-app&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;docker export my-app -o my-app.tar&lt;br&gt;&lt;/div&gt;&lt;div&gt;scp my-app.tar user@remote_host:/path/on/remote/&lt;/div&gt;&lt;div&gt;ssh alex@192.168.1.100&lt;/div&gt;&lt;div&gt;docker import my-app.tar my-app-image:latest&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;docker run -d -p 5000:5000 --name registry registry:2&lt;br&gt;docker tag my-app localhost:5000/my-app&lt;br&gt;docker push localhost:5000/my-app&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=8;" vertex="1" parent="kOdEl1zKcEWFtkfrxy2P-19">
          <mxGeometry x="390" y="479" width="370" height="193" as="geometry" />
        </mxCell>
        <mxCell id="kOdEl1zKcEWFtkfrxy2P-20" value="" style="group" vertex="1" connectable="0" parent="1">
          <mxGeometry x="10" y="750" width="810" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kOdEl1zKcEWFtkfrxy2P-3" value="IMAGEs" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=15;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;" vertex="1" parent="kOdEl1zKcEWFtkfrxy2P-20">
          <mxGeometry width="810" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kOdEl1zKcEWFtkfrxy2P-8" value="Команда&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Описание&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Вывод&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;div&gt;docker images [-a]&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Список всех образов&amp;nbsp;-a: включая промежуточные &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Таблица: REPOSITORY, TAG, IMAGE ID&amp;nbsp;&lt;/div&gt;&lt;div&gt;docker pull &amp;lt;IMAGE&amp;gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Скачивает образ из реестра&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Ход загрузки&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;/div&gt;docker rmi [-f] &amp;lt;IMAGE&amp;gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Удаляет образ&amp;nbsp;-f: принудительно &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Имя или ID удалённого&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;docker build -t &amp;lt;NAME&amp;gt; .&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Собирает образ из Dockerfile&amp;nbsp;-t: имя:тег &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Лог сборки&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;br&gt;docker tag &amp;lt;IMAGE&amp;gt; &amp;lt;NEW_TAG&amp;gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Присваивает образу новый тег&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Нет вывода&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;docker save &amp;lt;IMAGE&amp;gt; &amp;gt; file.tar&amp;nbsp;&amp;nbsp;&amp;nbsp; Сохраняет образ в файл&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Архив `.tar`&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;br&gt;docker load &amp;lt; file.tar&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Загружает образ из файла&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; Импорт образа&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontFamily=Courier New;fontSize=8;" vertex="1" parent="kOdEl1zKcEWFtkfrxy2P-20">
          <mxGeometry y="5" width="630" height="80" as="geometry" />
        </mxCell>
